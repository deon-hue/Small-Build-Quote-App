# Copy this file to .env.local and fill in your Supabase credentials
# Get these from: https://supabase.com → your project → Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Your Anthropic API key for the AI scope writer (server-side only — never exposed to browser)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Xero integration (server-side only). Create an app at https://developer.xero.com → My Apps.
# Redirect URI to register there: https://YOUR-APP-DOMAIN/api/xero/callback (and http://localhost:3000/api/xero/callback for local)
XERO_CLIENT_ID=your-xero-client-id
XERO_CLIENT_SECRET=your-xero-client-secret
# Optional: only set if you want to force a specific redirect (otherwise derived from the request origin)
# XERO_REDIRECT_URI=https://YOUR-APP-DOMAIN/api/xero/callback
