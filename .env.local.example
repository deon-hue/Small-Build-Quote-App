# Every setting the app reads. Copy this file to .env.local for local work; on Netlify, add the same names
# under Site configuration → Environment variables (each site — live and staging — has its own set of values).
#
#   [LIVE]     real value on the live site (app.buildospro.ai)
#   [STAGING]  safe/test value on the staging site — never reuse the live Supabase keys, Xero app,
#              or messaging keys on staging
#
# Never put real values in this file: it is committed. Real values go in .env.local (git-ignored) or Netlify.

# ── Supabase (Settings → API in the Supabase dashboard) ──────────────────────────────────────────────
# [LIVE] the live project   [STAGING] the separate staging project
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Server-side only. Bypasses all row-level security — the project ref in this key MUST match the URL above.
# Used by the public Get-a-Quote routes, portal invites, signed file links, email-ingest.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── The app's own public address ─────────────────────────────────────────────────────────────────────
# Used in links inside emails/WhatsApp. No trailing slash.
# [LIVE] https://app.buildospro.ai   [STAGING] the staging site's address
NEXT_PUBLIC_APP_URL=https://app.buildospro.ai
# Marks which environment this is, so a banner can say STAGING. Leave unset on live.
# [STAGING] staging
# NEXT_PUBLIC_APP_ENV=staging

# ── AI (server-side only — never exposed to the browser) ─────────────────────────────────────────────
# [STAGING] use a separate key with a spend limit set in the Anthropic console
ANTHROPIC_API_KEY=sk-ant-your-key-here
# Optional: only the public "visualise your project" feature uses these
# OPENAI_API_KEY=
# UNSPLASH_ACCESS_KEY=

# ── Email (Resend) ───────────────────────────────────────────────────────────────────────────────────
# Quote, portal-invite and notification emails.
# [STAGING] a separate Resend key, or leave RESEND_API_KEY unset so staging cannot send email at all
RESEND_API_KEY=re_your-resend-key
NOTIFY_FROM_EMAIL=noreply@buildospro.ai

# ── WhatsApp (Twilio) — optional ─────────────────────────────────────────────────────────────────────
# [STAGING] LEAVE ALL THREE UNSET so staging can never message a real person
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=

# ── Xero (server-side only). Create an app at https://developer.xero.com → My Apps ───────────────────
# [STAGING] a separate Xero app connected to the Xero Demo Company only
XERO_CLIENT_ID=your-xero-client-id
XERO_CLIENT_SECRET=your-xero-client-secret
# Register https://YOUR-APP-DOMAIN/api/xero/callback in the Xero app (and http://localhost:3000/... for local).
# Optional override; otherwise derived from the address the visitor used.
# XERO_REDIRECT_URI=https://YOUR-APP-DOMAIN/api/xero/callback

# ── Single-company public pages (until the per-company Get-a-Quote work is done) ─────────────────────
# Whose Back Office rates / settings the public Get-a-Quote estimate uses, and who receives its requests.
# [STAGING] the id of a staging test user — a live id simply finds nothing there
# BUILDER_USER_ID=
# BUILDER_NOTIFICATION_EMAIL=
# Inbound-email document inbox (Power Automate / Postmark webhook). [STAGING] leave unset.
# EMAIL_INGEST_TOKEN=
# EMAIL_INGEST_USER_ID=
